-- Tab Switcher Logic with Smooth, Non-Dramatic Section Animation
local activeTabBtn = nil
local isAnimating = false

local function switchTab(sectionName, tabBtn)
if isAnimating or activeTabBtn == tabBtn then return end
isAnimating = true

for name, sec in pairs(sections) do
if name ~= sectionName then
sec.Visible = false
end
end

local targetSec = sections[sectionName]
targetSec.Position = UDim2.new(0.06, 0, 0, 0)
targetSec.Visible = true

local slideIn = TweenService:Create(targetSec, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
slideIn:Play()
slideIn.Completed:Connect(function()
isAnimating = false
end)

if activeTabBtn then
activeTabBtn.BackgroundColor3 = Color3.fromRGB(236, 241, 247)
activeTabBtn.TextColor3 = Color3.fromRGB(80, 95, 115)
end
activeTabBtn = tabBtn
tabBtn.BackgroundColor3 = Color3.fromRGB(222, 233, 245)
tabBtn.TextColor3 = Color3.fromRGB(30, 110, 195)
end

