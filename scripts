local function createSlider(parent, name, minVal, maxVal, currentVal, callback)
local wrapper = Instance.new("Frame")
wrapper.Size = UDim2.new(1, 0, 0, 42)
wrapper.BackgroundTransparency = 1
wrapper.ZIndex = 2

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 0, 18)
label.BackgroundTransparency = 1
label.Font = Enum.Font.Code
label.Text = " " .. name .. ": " .. tostring(currentVal)
label.TextColor3 = Color3.fromRGB(80, 95, 115)
label.TextSize = 11
label.TextXAlignment = Enum.TextXAlignment.Left
label.ZIndex = 2
label.Parent = wrapper

local sliderBar = Instance.new("TextButton")
sliderBar.AutoButtonColor = false
sliderBar.Text = ""
sliderBar.Size = UDim2.new(1, 0, 0, 8)
sliderBar.Position = UDim2.new(0, 0, 0, 22)
sliderBar.BackgroundColor3 = Color3.fromRGB(235, 241, 248)
sliderBar.BorderSizePixel = 0
sliderBar.ZIndex = 2
sliderBar.Parent = wrapper

local barStroke = Instance.new("UIStroke")
barStroke.Color = Color3.fromRGB(210, 225, 242)
barStroke.Thickness = 1
barStroke.Parent = sliderBar

local fillBar = Instance.new("Frame")
local initialRatio = (currentVal - minVal) / (maxVal - minVal)
fillBar.Size = UDim2.new(initialRatio, 0, 1, 0)
fillBar.BackgroundColor3 = Color3.fromRGB(50, 150, 245)
fillBar.BorderSizePixel = 0
fillBar.ZIndex = 3
fillBar.Parent = sliderBar

local sliderThumb = Instance.new("Frame")
sliderThumb.Size = UDim2.new(0, 8, 0, 14)
sliderThumb.AnchorPoint = Vector2.new(0.5, 0.5)
sliderThumb.Position = UDim2.new(initialRatio, 0, 0.5, 0)
sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
sliderThumb.BorderSizePixel = 0
sliderThumb.ZIndex = 4
sliderThumb.Parent = sliderBar

local thumbStroke = Instance.new("UIStroke")
thumbStroke.Color = Color3.fromRGB(180, 205, 235)
thumbStroke.Thickness = 1
thumbStroke.Parent = sliderThumb

local dragging = false

local function updateSlider(input)
local mousePos = input.Position.X
local barPos = sliderBar.AbsolutePosition.X
local barSize = sliderBar.AbsoluteSize.X
local posRatio = math.clamp((mousePos - barPos) / barSize, 0, 1)

local newVal = minVal + (maxVal - minVal) * posRatio
if maxVal > 1 and maxVal ~= 0.3 and maxVal ~= 0.5 then
newVal = math.floor(newVal)
else
newVal = tonumber(string.format("%.2f", newVal))
end

fillBar.Size = UDim2.new(posRatio, 0, 1, 0)
sliderThumb.Position = UDim2.new(posRatio, 0, 0.5, 0)
label.Text = " " .. name .. ": " .. tostring(newVal)
callback(newVal)
end

sliderBar.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
updateSlider(input)
end
end)

UIS.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = false
end
end)

UIS.InputChanged:Connect(function(input)
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
updateSlider(input)
end
end)

wrapper.Parent = parent
end

